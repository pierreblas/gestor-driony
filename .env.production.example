# Copia este archivo como .env.production y rellénalo.

# Puerto del SERVIDOR donde se abrirá la app (el 3000 ya está ocupado).
APP_PORT=3100

# Interfaz donde escuchar. 0.0.0.0 = accesible desde la red.
# Usa 127.0.0.1 si vas a poner delante un proxy (Nginx, Caddy, Traefik).
APP_BIND=0.0.0.0

# Dirección pública con la que entra la gente. Se usa en los enlaces de los correos.
# Debe incluir el puerto si no usas un proxy: http://IP-DEL-SERVIDOR:3100
APP_URL=http://IP-DEL-SERVIDOR:3100

# Secreto para cifrar la contraseña SMTP. Genera uno con:
#   openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-largo

# Cuenta master: siempre es administradora.
MASTER_EMAIL=papuulima10@gmail.com

# Cookie de sesión solo por HTTPS. Si se deja vacío, se activa sola cuando APP_URL empieza por https://
# COOKIE_SECURE=true

# Opcional: clave de Anthropic para el copiloto. Es más cómodo ponerla en Ajustes,
# que además tiene prioridad sobre esta.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
