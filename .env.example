DATABASE_URL="file:./dev.db"

# Secreto para cifrar la contraseña SMTP. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="cambia-esto"

# Cuenta master: siempre es administradora y no se puede desactivar ni eliminar.
MASTER_EMAIL="tu-correo@ejemplo.com"

# Dirección pública de la app, para los enlaces de los correos.
APP_URL="http://localhost:3000"
